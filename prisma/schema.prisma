generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// LeadType enum removed — lead classification now lives in the
// lead_categories table. leadType columns are plain strings.

enum PartnerStatus {
  pending_approval
  active
  rejected
  disabled
}

enum LeadStatus {
  unmatched
  delivered
  integrity_posted
  dead
  review
}

enum LeadCategoryResolution {
  matched
  no_match
  multiple_matches
}

enum LeadEventType {
  received
  matched
  delivered
  delivery_failed
  refunded
  integrity_posted
  integrity_accepted
  integrity_rejected
  integrity_no_campaign
  integrity_skipped
  integrity_error
  integrity_missing_fields
  aged_purchased
  aged_partner_sold
  reprocessed
  duplicate_rejected
  trustedform_failed
  deleted
  category_assigned
}

enum PartnerCrmOutboundAuthType {
  none
  bearer
  api_key_header
  basic
  body_fields
}

enum PartnerCrmOutboundHttpMethod {
  POST
}

enum DeliveryChannel {
  realtime
  aged
}

enum TransactionType {
  top_up
  admin_grant
  admin_debit
  lead_purchase
  aged_purchase
  refund
  reprocessing_fee
}

enum RefundStatus {
  pending
  approved
  rejected
}

enum ResaleMode {
  realtime
  storefront
}

enum ResaleStatus {
  pending
  sold
  rejected
  reconciled
}

enum AgedCheckoutStatus {
  pending
  paid
  expired
}

enum MigrationJobStatus {
  pending
  running
  completed
  failed
}

enum BillingInterval {
  weekly
}

enum LeadListViewScope {
  admin
  partner
}

/// Single source of truth for all lead classification.
/// `type` is the immutable internal key (set at creation, never editable).
/// `integrityLabel` is the Realtime `lead_type_thom` string for Integrity Connect.
/// `integrityLabelStorefront` is the Storefront label; blank falls back to Realtime.
model LeadCategory {
  id                       String   @id @default(uuid()) @db.Uuid
  type                     String   @unique
  label                    String
  defaultPrice             Decimal? @map("default_price") @db.Decimal(10, 2)
  enabled                  Boolean  @default(true)
  partnerEnabled           Boolean  @default(true) @map("partner_enabled")
  /// Max non-refunded realtime partner sales. Default 1 keeps production exclusive.
  maxRealtimeSells         Int      @default(1) @map("max_realtime_sells")
  integrityLabel           String?  @map("integrity_label")
  integrityLabelStorefront String?  @map("integrity_label_storefront")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  criteria LeadCategoryCriterion[]

  @@map("lead_categories")
}

model LeadCategoryCriterion {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  field      String
  value      String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category LeadCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, field])
  @@index([categoryId])
  @@map("lead_category_criteria")
}

model AdminProfile {
  clerkUserId String   @id @map("clerk_user_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("admin_profiles")
}

model Partner {
  id               String        @id @default(uuid()) @db.Uuid
  clerkUserId      String?       @unique @map("clerk_user_id")
  email            String
  firstName        String        @map("first_name")
  lastName         String        @map("last_name")
  affiliation      String?
  avatarUrl        String?       @map("avatar_url")
  residenceState   String        @map("residence_state")
  filterStates     String[]      @map("filter_states")
  priority         Int           @default(5)
  priceOverride    Decimal?      @map("price_override") @db.Decimal(10, 2)
  walletBalance    Decimal       @default(0) @map("wallet_balance") @db.Decimal(10, 2)
  status           PartnerStatus @default(pending_approval)
  stripeCustomerId String?       @map("stripe_customer_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  leadDeliveries       LeadDelivery[]
  refundRequests       RefundRequest[]
  transactions         Transaction[]
  billingRecurrences   BillingRecurrence[]
  reviewedRefunds      RefundRequest[]           @relation("ReviewedBy")
  createdMigrationJobs MigrationJob[]
  filterSets           PartnerFilterSet[]
  leadListViews        LeadListView[]
  crmOutboundConfig    PartnerCrmOutboundConfig?
  agedCheckouts        AgedCheckout[]

  @@index([status])
  @@index([priority])
  @@map("partners")
}

model AgedCheckout {
  id                      String              @id @default(uuid()) @db.Uuid
  partnerId               String              @map("partner_id") @db.Uuid
  stripeCheckoutSessionId String?             @unique @map("stripe_checkout_session_id")
  leadIds                 String[]            @map("lead_ids")
  quotedTotal             Decimal             @map("quoted_total") @db.Decimal(10, 2)
  status                  AgedCheckoutStatus  @default(pending)
  expiresAt               DateTime            @map("expires_at")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  partner    Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  heldLeads  Lead[]

  @@index([partnerId, status])
  @@map("aged_checkouts")
}

model PartnerCrmOutboundConfig {
  partnerId     String                       @id @map("partner_id") @db.Uuid
  enabled       Boolean                      @default(false)
  endpointUrl   String                       @map("endpoint_url")
  httpMethod    PartnerCrmOutboundHttpMethod @default(POST) @map("http_method")
  authType      PartnerCrmOutboundAuthType   @map("auth_type")
  authConfig    Json                         @default("{}") @map("auth_config")
  fieldMappings Json                         @default("[]") @map("field_mappings")
  successRule   Json                         @default("{\"require2xx\": true}") @map("success_rule")
  createdAt     DateTime                     @default(now()) @map("created_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_crm_outbound_configs")
}

model LeadListView {
  id                   String            @id @default(uuid()) @db.Uuid
  scope                LeadListViewScope
  partnerId            String?           @map("partner_id") @db.Uuid
  name                 String
  filters              Json
  sort                 Json
  columns              Json
  isDefault            Boolean           @default(false) @map("is_default")
  createdByClerkUserId String?           @map("created_by_clerk_user_id")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  partner Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([scope, partnerId])
  @@map("lead_list_views")
}

model PartnerFilterSet {
  id             String   @id @default(uuid()) @db.Uuid
  partnerId      String?  @map("partner_id") @db.Uuid
  name           String   @default("Default")
  leadType       String   @map("lead_type")
  filterStates   String[] @map("filter_states")
  priority       Int      @default(5)
  priceOverride  Decimal? @map("price_override") @db.Decimal(10, 2)
  active         Boolean  @default(true)
  isTemplate     Boolean  @default(false) @map("is_template")
  weeklyLimit    Int?     @map("weekly_limit")
  monthlyLimit   Int?     @map("monthly_limit")
  filterCriteria Json     @default("{}") @map("filter_criteria")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  partner        Partner?       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  leadDeliveries LeadDelivery[]

  @@index([partnerId, active])
  @@index([leadType])
  @@index([isTemplate])
  @@map("partner_filter_sets")
}

model Lead {
  id                      String                 @id @default(uuid()) @db.Uuid
  firstName               String                 @map("first_name")
  lastName                String                 @map("last_name")
  email                   String
  phone                   String
  address                 String?
  city                    String?
  state                   String
  zip                     String?
  dob                     String?
  age                     String?
  leadType                String?                @map("lead_type")
  categoryResolution      LeadCategoryResolution @default(matched) @map("category_resolution")
  categoryCandidateTypes  String[]               @default([]) @map("category_candidate_types")
  intent                  String?
  haveIul                 String?                @map("have_iul")
  primaryGoal             String?                @map("primary_goal")
  stateYouCurrentlyLiveIn String?                @map("state_you_currently_live_in")
  beneficiary             String?                @map("beneficiary")
  beneficiaryType         String?                @map("beneficiary_type")
  historyOfCancer         String?                @map("history_of_cancer")
  mortgageLoanAmount      String?                @map("mortgage_loan_amount")
  trustedformCertUrl      String?                @map("trustedform_cert_url")
  trustedformValid        Boolean?               @map("trustedform_valid")
  trustedformCheckedAt    DateTime?              @map("trustedform_checked_at")
  tcpaConsent             String?                @map("tcpa_consent")
  tcpaLanguage            String?                @map("tcpa_language")
  leadidToken             String?                @map("leadid_token")
  source                  String                 @default("meta_leadconduit")
  landingPage             String?                @map("landing_page")
  subId                   String?                @map("sub_id")
  pubId                   String?                @map("pub_id")
  boberdooLeadType        String?                @map("boberdoo_lead_type")
  ipAddress               String?                @map("ip_address")
  userAgent               String?                @map("user_agent")
  receivedAt              DateTime               @default(now()) @map("received_at")
  available               Boolean                @default(true)
  refundable              Boolean                @default(true)
  status                  LeadStatus             @default(unmatched)
  externalId              String?                @map("external_id")
  rawPayload              Json?                  @map("raw_payload")
  agedSaleCount           Int                    @default(0) @map("aged_sale_count")
  agedAvailableAfter      DateTime?              @map("aged_available_after")
  agedHoldCheckoutId      String?                @map("aged_hold_checkout_id") @db.Uuid
  agedHoldExpiresAt       DateTime?              @map("aged_hold_expires_at")
  liveSoldAt              DateTime?              @map("live_sold_at")
  liveSaleChannel         String?                @map("live_sale_channel")
  lastRoutingAttemptAt    DateTime?              @map("last_routing_attempt_at")
  nextRoutingAttemptAt    DateTime?              @map("next_routing_attempt_at")
  routingAttemptCount     Int                    @default(0) @map("routing_attempt_count")
  integrityBlockedAt      DateTime?              @map("integrity_blocked_at")
  integrityBlockedReason  String?                @map("integrity_blocked_reason")
  routingClaimedAt        DateTime?              @map("routing_claimed_at")
  routingClaimedBy        String?                @map("routing_claimed_by")
  routingClaimExpiresAt   DateTime?              @map("routing_claim_expires_at")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  leadDeliveries LeadDelivery[]
  resalePostings ResalePosting[]
  events         LeadEvent[]
  agedHoldCheckout AgedCheckout? @relation(fields: [agedHoldCheckoutId], references: [id], onDelete: SetNull)

  @@index([state, status, available])
  @@index([receivedAt])
  @@index([available, receivedAt])
  @@index([status, available, nextRoutingAttemptAt])
  @@index([status, available, receivedAt])
  @@index([routingClaimExpiresAt])
  @@index([agedHoldExpiresAt])
  @@index([externalId])
  @@index([email, phone])
  @@map("leads")
}

model LeadEvent {
  id        String        @id @default(uuid()) @db.Uuid
  leadId    String        @map("lead_id") @db.Uuid
  type      LeadEventType
  payload   Json?
  actorId   String?       @map("actor_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_events")
}

model LeadDelivery {
  id                String          @id @default(uuid()) @db.Uuid
  leadId            String          @map("lead_id") @db.Uuid
  partnerId         String          @map("partner_id") @db.Uuid
  filterSetId       String?         @map("filter_set_id") @db.Uuid
  channel           DeliveryChannel
  price             Decimal         @db.Decimal(10, 2)
  deliveredAt       DateTime        @default(now()) @map("delivered_at")
  partnerSoldAt     DateTime?       @map("partner_sold_at")
  refundedAt        DateTime?       @map("refunded_at")
  lastDeliveryError String?         @map("last_delivery_error")
  createdAt         DateTime        @default(now()) @map("created_at")

  lead           Lead              @relation(fields: [leadId], references: [id])
  partner        Partner           @relation(fields: [partnerId], references: [id])
  filterSet      PartnerFilterSet? @relation(fields: [filterSetId], references: [id])
  refundRequests RefundRequest[]
  transactions   Transaction[]

  @@index([partnerId])
  @@index([leadId])
  @@index([filterSetId])
  @@index([refundedAt])
  @@map("lead_deliveries")
}

model RefundRequest {
  id             String       @id @default(uuid()) @db.Uuid
  leadDeliveryId String       @map("lead_delivery_id") @db.Uuid
  partnerId      String       @map("partner_id") @db.Uuid
  reason         String?
  refundType     String       @map("refund_type")
  status         RefundStatus @default(pending)
  reviewedById   String?      @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?    @map("reviewed_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  leadDelivery LeadDelivery @relation(fields: [leadDeliveryId], references: [id])
  partner      Partner      @relation(fields: [partnerId], references: [id])
  reviewedBy   Partner?     @relation("ReviewedBy", fields: [reviewedById], references: [id])

  @@map("refund_requests")
}

model Transaction {
  id                    String          @id @default(uuid()) @db.Uuid
  partnerId             String          @map("partner_id") @db.Uuid
  type                  TransactionType
  amount                Decimal         @db.Decimal(10, 2)
  balanceAfter          Decimal         @map("balance_after") @db.Decimal(10, 2)
  stripePaymentIntentId String?         @unique @map("stripe_payment_intent_id")
  stripeRefundId        String?         @unique @map("stripe_refund_id")
  stripeRefundPaymentIntentId String?   @map("stripe_refund_payment_intent_id")
  leadDeliveryId        String?         @map("lead_delivery_id") @db.Uuid
  description           String?
  acknowledgedAt        DateTime?       @map("acknowledged_at")
  createdAt             DateTime        @default(now()) @map("created_at")

  partner      Partner       @relation(fields: [partnerId], references: [id])
  leadDelivery LeadDelivery? @relation(fields: [leadDeliveryId], references: [id])

  @@index([partnerId])
  @@index([stripeRefundPaymentIntentId])
  @@map("transactions")
}

model ProcessedStripeEvent {
  id        String   @id
  eventType String   @map("event_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("processed_stripe_events")
}

model BillingRecurrence {
  id                   String          @id @default(uuid()) @db.Uuid
  partnerId            String          @map("partner_id") @db.Uuid
  amount               Decimal         @db.Decimal(10, 2)
  interval             BillingInterval
  stripeSubscriptionId String?         @map("stripe_subscription_id")
  active               Boolean         @default(true)
  nextChargeAt         DateTime?       @map("next_charge_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  partner Partner @relation(fields: [partnerId], references: [id])

  @@map("billing_recurrence")
}

model ResalePosting {
  id           String       @id @default(uuid()) @db.Uuid
  leadId       String       @map("lead_id") @db.Uuid
  mode         ResaleMode
  status       ResaleStatus @default(pending)
  externalRef  String?      @map("external_ref")
  postedAt     DateTime?    @map("posted_at")
  soldAt       DateTime?    @map("sold_at")
  revenueShare Decimal?     @map("revenue_share") @db.Decimal(10, 2)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@map("resale_postings")
}

model AppSetting {
  key   String @id
  value Json

  @@map("app_settings")
}

model MigrationJob {
  id          String             @id @default(uuid()) @db.Uuid
  status      MigrationJobStatus @default(pending)
  fileName    String             @map("file_name")
  totalRows   Int                @default(0) @map("total_rows")
  successRows Int                @default(0) @map("success_rows")
  errorRows   Int                @default(0) @map("error_rows")
  errorLog    Json?              @map("error_log")
  createdById String?            @map("created_by") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at")
  completedAt DateTime?          @map("completed_at")

  createdBy Partner? @relation(fields: [createdById], references: [id])

  @@map("migration_jobs")
}
